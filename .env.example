# AWS credentials for the demo. Copy to .env and fill in.
# .env is gitignored — never commit real credentials.
# Terraform's AWS provider reads these from the environment automatically.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only needed for temporary / STS (assumed-role) credentials:
# AWS_SESSION_TOKEN=

# Region for the AWS CLI/SDK. The Terraform provider region is controlled by
# the `aws_region` variable (default us-east-1); keep this in sync.
AWS_REGION=us-east-1
